# See https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# AI provider: mock | browser-agent | prompt-only
# prompt-only = só monta prompts pra colar no Flow (sem abrir navegador)
AI_PROVIDER=prompt-only

# assisted = abre Flow, cola prompt e espera você confirmar/gerar
# auto = tenta clicar em gerar sozinho (mais frágil se a UI mudar)
BROWSER_AGENT_MODE=assisted

GOOGLE_FLOW_URL=https://flow.google/
KALODATA_URL=https://www.kalodata.com/

# Max upload size in bytes (default 8MB)
MAX_UPLOAD_BYTES=8388608

# Local data directories (relative to project root)
DATA_DIR=data
UPLOAD_DIR=uploads

# --- DICloak (perfil Flow/Veo3 que você abre com Abrir) ---
# No DICloak: Mais → Configurações → Open API → copie URL e chave
# DICLOAK_API_URL=http://127.0.0.1:52140
# DICLOAK_API_KEY=
# Número da coluna no DICloak (ex.: 66 = Flow/Veo3)
# DICLOAK_PROFILE_SERIAL=66
# Ou o ID longo do perfil:
# DICLOAK_PROFILE_ID=

# Alternativa: CDP direto (se já tiver ws:// ou http://127.0.0.1:PORT)
# BROWSER_CDP_URL=

# Optional future API keys — NEVER commit real values
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
# FAL_KEY=
